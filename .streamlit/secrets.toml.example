# =============================================================================
# FoodBridge AI - Supabase Configuration Template
# =============================================================================
# 1. Create a free project at https://supabase.com
# 2. In your Supabase Dashboard, go to Project Settings -> API
# 3. Copy your "Project URL" and "anon public" API key below
# 4. Save this file as .streamlit/secrets.toml
# =============================================================================

[supabase]
url = "https://your-project-ref.supabase.co"
key = "your-anon-public-key-here"
